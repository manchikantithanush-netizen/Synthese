  "cyA4TblDurationF": "Duration",
  "cyA4TblDurationS": "Hours to 1–2 days",
  "cyA4TblDurationP": "3 to 7 days",
  "cyA4TblClotsF": "Clots",
  "cyA4TblClotsS": "None",
  "cyA4TblClotsP": "Possible, especially on heavy days",
